# Salin file ini menjadi ".env" di root repo untuk mengubah konfigurasi default docker-compose.

POSTGRES_USER=hris
POSTGRES_PASSWORD=hris
POSTGRES_DB=hris

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hris-documents

# Kosongkan SMTP_HOST untuk mode dev (email hanya di-log oleh backend, tidak dikirim sungguhan)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HRIS <no-reply@hris.local>

FRONTEND_URL=http://localhost:3000
